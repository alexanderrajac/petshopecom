# Application Environment (development | production)
NODE_ENV=production

# Server Port
PORT=5001

# MongoDB Connection String (Atlas URI or self-hosted MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/petshop?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/petshop

# JSON Web Token Secret (Use a strong random string in production)
JWT_SECRET=replace_with_a_secure_random_64_char_key_for_production

# UPI / Google Pay Merchant ID for checkout
UPI_ID=8248651695@ybl

# PayPal Client ID (Optional / Sandbox)
PAYPAL_CLIENT_ID=sb